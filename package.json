{
  "name": "musicdj-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "MusicDJ desktop packaging workspace",
  "scripts": {
    "check:env": "powershell.exe -ExecutionPolicy Bypass -File scripts/check-env.ps1",
    "build:backend": "powershell.exe -ExecutionPolicy Bypass -File scripts/build-backend.ps1",
    "build:netease": "powershell.exe -ExecutionPolicy Bypass -File scripts/build-netease.ps1",
    "build:sidecars": "powershell.exe -ExecutionPolicy Bypass -File scripts/build-sidecars.ps1",
    "setup:nsis": "powershell.exe -ExecutionPolicy Bypass -File scripts/setup-nsis.ps1",
    "tauri:dev": "powershell.exe -ExecutionPolicy Bypass -Command \". ./scripts/env.ps1; npm.cmd exec tauri dev\"",
    "tauri:build": "powershell.exe -ExecutionPolicy Bypass -Command \"& ./scripts/setup-nsis.ps1; npm.cmd exec tauri build\"",
    "build:release": "powershell.exe -ExecutionPolicy Bypass -File scripts/build-release.ps1"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.0.0",
    "@tauri-apps/cli": "^2.0.0"
  },
  "dependencies": {
    "@tauri-apps/plugin-shell": "^2.0.0"
  }
}
